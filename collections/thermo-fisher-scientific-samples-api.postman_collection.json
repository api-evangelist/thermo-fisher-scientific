          "name": "Get Samples",
          "request": {
            "name": "Get Samples",
            "description": {
              "content": "Returns a list of laboratory samples accessible to the authenticated user. Supports filtering by status, date range, and other criteria.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "mobile",
                "samples"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "Sample status filter (A=Authorized, C=Completed, X=Cancelled, L=Login pending)."
                },
                {
                  "disabled": false,
                  "key": "from_date",
                  "value": "<date>",
                  "description": "Filter samples from this date (YYYY-MM-DD)."
                },
                {
                  "disabled": false,
                  "key": "to_date",
                  "value": "<date>",
                  "description": "Filter samples to this date (YYYY-MM-DD)."
                },
                {
                  "disabled": false,
                  "key": "pagesize",
                  "value": "50",
                  "description": "Number of records per page."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page number."
                }
              ],
              "variable": [
                {
                  "description": "IP address of the NanoDrop Ultra instrument on the local network.",
                  "type": "any",
                  "value": "{{instrument-ip}}",
                  "key": "instrument-ip"
                },
                {
                  "description": "API port.",
                  "type": "any",
                  "value": "{{port}}",
                  "key": "port"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
